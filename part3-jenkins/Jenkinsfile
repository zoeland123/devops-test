pipeline {
  agent any
  environment {
    REGISTRY = 'docker.io/GANTI-USERNAME-DOCKERHUB'
    APP      = 'hello-devops'
  }
  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script { env.VERSION = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim() }
      }
    }
    stage('Test') {
      steps { sh 'go vet ./... && go test -v ./...' }
      post { failure { echo 'TEST GAGAL: Build, Push, dan Deploy dibatalkan.' } }
    }
    stage('Build Image') {
      steps { sh 'docker build --build-arg VERSION=${VERSION} -t ${REGISTRY}/${APP}:${VERSION} .' }
    }
    stage('Push') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
            usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
          sh '''
            echo "$REG_PASS" | docker login -u "$REG_USER" --password-stdin
            docker push ${REGISTRY}/${APP}:${VERSION}
          '''
        }
      }
    }
    stage('Deploy') {
      steps { sh './scripts/deploy.sh ${REGISTRY}/${APP}:${VERSION} app' }
    }
  }
  post { failure { echo 'Pipeline gagal, lihat stage yang merah.' } }
}
